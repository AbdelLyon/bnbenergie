{
  "name": "bnbenergie",
  "version": "1.0.0",
  "description": "BNB Energie",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build --webpack",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation next lint",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "db:start": "docker compose up -d postgres",
    "db:stop": "docker compose stop postgres",
    "db:restart": "docker compose restart postgres",
    "db:logs": "docker compose logs -f postgres"
  },
  "dependencies": {
    "@ai-sdk/groq": "^3.0.36",
    "@emotion/is-prop-valid": "^1.4.0",
    "@heroui/system": "^2.4.28",
    "@heroui/theme": "^2.4.26",
    "@payloadcms/db-postgres": "^3.68.5",
    "@payloadcms/next": "^3.68.5",
    "@payloadcms/richtext-lexical": "^3.68.5",
    "@payloadcms/storage-vercel-blob": "^3.68.5",
    "@payloadcms/translations": "^3.68.5",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.4.2",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "ai": "^6.0.169",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "framer-motion": "12.23.24",
    "graphql": "^16.12.0",
    "lucide-react": "^0.552.0",
    "next": "16.2.2",
    "next-themes": "^0.4.6",
    "nodemailer": "^7.0.11",
    "payload": "^3.68.5",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "sharp": "^0.34.5",
    "three": "^0.181.2",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.2",
    "@next/eslint-plugin-next": "^16.0.10",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^22.19.3",
    "@types/nodemailer": "^7.0.4",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@types/three": "^0.181.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "baseline-browser-mapping": "^2.10.27",
    "critters": "^0.0.25",
    "eslint": "^9.39.2",
    "knip": "^5.74.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "5.7.3",
    "typescript-eslint": "^8.50.0"
  }
}
